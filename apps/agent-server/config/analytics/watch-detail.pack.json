{
  "version": "2026-09-12.01",
  "id": "watch-detail",
  "datasource": {
    "engine": "clickhouse",
    "metabaseDatabaseId": 2
  },
  "tables": [
    {
      "name": "elt_watch_detail",
      "fields": [
        "lastWatchTime",
        "channel",
        "contentLang",
        "watchSecond",
        "guid",
        "movieType",
        "eid",
        "maxWatchProgress"
      ]
    }
  ],
  "probeDimensions": ["channel", "contentLang", "movieType"],
  "required_filters": ["time_range"],
  "time": {
    "businessTimezone": "Asia/Shanghai",
    "missingYearDefault": "clock_year"
  },
  "guards": {
    "distinctCountFn": "uniq",
    "maxRows": 5000,
    "maxProbeRounds": 3,
    "maxRewriteRounds": 2,
    "parallelism": 4,
    "defaultMovieTypes": [1, 2, 3, 4, 10, 11],
    "queryTimeoutMs": 120000,
    "forcedFilters": {}
  },
  "enumDimensions": [
    {
      "id": "contentLang",
      "field": "contentLang",
      "aliases": ["语言", "语种", "小语种", "contentLang", "英语", "英文"],
      "setSignals": ["\\d+种", "[一二三四五六七八九十两几多各]种", "几种", "多种", "各类", "小语种"],
      "domain": "probe",
      "valueDomain": "literal"
    },
    {
      "id": "movieType",
      "field": "movieType",
      "aliases": ["影片类型", "内容类型", "影片", "movieType"],
      "setSignals": ["\\d+种", "[一二三四五六七八九十两几多各]种", "几种", "多种", "各类"],
      "domain": "probe",
      "valueDomain": "metabase_lexicon",
      "defaultWhenAbsent": true
    }
  ],
  "metricDefs": [
    {
      "id": "completion_rate",
      "aliases": ["完播率", "完播"],
      "options": [
        {
          "id": "avg_max_progress",
          "label": "最大观看进度平均值",
          "groundSignals": ["最大进度", "最大观看进度", "maxWatchProgress"],
          "compile": {
            "kind": "avg_of_max",
            "valueField": "maxWatchProgress",
            "entityKeys": ["guid", "eid"]
          }
        },
        {
          "id": "pct_ge_threshold",
          "label": "进度≥阈值占比",
          "groundSignals": ["阈值", "大于等于", "≥"]
        }
      ]
    },
    {
      "id": "watch_duration",
      "aliases": ["观看时长", "人均时长", "人均观看时长", "watchSecond"],
      "options": [
        {
          "id": "avg_watch_second_per_user",
          "label": "人均观看时长（秒）",
          "groundSignals": ["人均", "人均观看", "人均时长"],
          "compile": {
            "kind": "avg_per_user",
            "valueField": "watchSecond",
            "distinctField": "guid"
          }
        },
        {
          "id": "sum_watch_second",
          "label": "观看时长合计（秒）",
          "groundSignals": ["合计", "总时长", "总观看", "时长合计"],
          "compile": {
            "kind": "sum",
            "valueField": "watchSecond"
          }
        }
      ]
    }
  ],
  "capabilities": {
    "ops": [
      "base_aggregate",
      "pivot_wide",
      "pivot_long",
      "side_by_side",
      "yoy",
      "mom",
      "growth_rate",
      "merge_ratio"
    ],
    "metrics": [
      "uniq_users",
      "sum_watch_second",
      "avg_watch_second_per_user",
      "avg_max_progress"
    ],
    "downgradePolicy": "strict",
    "unsupportedOpsHint": {
      "yoy": {
        "hint": "同比（本期 vs 去年同期）",
        "groundSignals": ["同比", "同比增长", "yoy", "YoY", "year-over-year", "year over year"]
      },
      "growth_rate": {
        "hint": "增长率（相对基期）",
        "groundSignals": ["增长率", "增速", "growth rate", "growth_rate"]
      },
      "merge_ratio": {
        "hint": "多步比值/增长率合并",
        "groundSignals": []
      },
      "mom": {
        "hint": "环比（本期 vs 等长上一窗）",
        "groundSignals": ["环比", "环比增长", "mom", "MoM", "month-over-month"]
      },
      "top_n": {
        "hint": "TopN 排名尚未建模",
        "groundSignals": ["TopN", "Top N", "top\\s*\\d+", "前\\d+名", "前\\d+"]
      },
      "percentile": {
        "hint": "分位数尚未建模",
        "groundSignals": ["分位", "percentile", "P50", "P90", "P95", "P99"]
      },
      "merge_diff": {
        "hint": "多步差值合并尚未建模",
        "groundSignals": []
      }
    }
  },
  "delivery": {
    "missingChannel": "zero_fill"
  }
}
