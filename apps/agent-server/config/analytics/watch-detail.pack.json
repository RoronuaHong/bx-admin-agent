{
  "version": "2026-09-14.01",
  "id": "watch-detail",
  "datasource": {
    "engine": "clickhouse",
    "metabaseDatabaseId": 2
  },
  "tables": [
    {
      "name": "elt_watch_detail",
      "fields": [
        "lastWatchTime",
        "channel",
        "contentLang",
        "watchSecond",
        "guid",
        "movieType",
        "eid",
        "maxWatchProgress"
      ]
    }
  ],
  "entities": [
    { "id": "device", "keys": ["guid"] },
    { "id": "account", "keys": ["uid", "_id"] }
  ],
  "relationships": [
    {
      "id": "user_order",
      "left": { "table": "elt_film_user", "key": "_id" },
      "right": { "table": "elt_film_order", "key": "uid" },
      "join": "inner"
    },
    {
      "id": "new_active",
      "left": { "table": "elt_new_guid", "key": "guid" },
      "right": { "table": "elt_active_guid", "key": "guid" },
      "join": "inner"
    },
    {
      "id": "gather_new",
      "left": { "table": "gather", "schema": "gather", "key": "guid" },
      "right": { "table": "elt_new_guid", "key": "guid" },
      "join": "inner"
    }
  ],
  "probeDimensions": ["channel", "contentLang", "movieType"],
  "required_filters": ["time_range"],
  "time": {
    "businessTimezone": "Asia/Shanghai",
    "missingYearDefault": "clock_year",
    "field": "lastWatchTime"
  },
  "guards": {
    "distinctCountFn": "uniq",
    "maxRows": 5000,
    "maxProbeRounds": 3,
    "maxRewriteRounds": 2,
    "parallelism": 4,
    "defaultMovieTypes": [1, 2, 3, 4, 10, 11],
    "defaultWideLangs": ["", "te-IN", "ta-IN", "ml-IN"],
    "queryTimeoutMs": 120000,
    "forcedFilters": {}
  },
  "enumDimensions": [
    {
      "id": "channel",
      "field": "channel",
      "aliases": ["渠道", "频道", "channel"],
      "domain": "probe",
      "valueDomain": "literal",
      "valueAliases": {
        "印度A": "IndiaA",
        "印度B": "IndiaB",
        "印度a": "IndiaA"
      }
    },
    {
      "id": "contentLang",
      "field": "contentLang",
      "aliases": ["语言", "语种", "小语种", "contentLang", "英语", "英文"],
      "setSignals": ["\\d+种", "[一二三四五六七八九十两几多各]种", "几种", "多种", "各类", "小语种"],
      "domain": "probe",
      "valueDomain": "literal"
    },
    {
      "id": "movieType",
      "field": "movieType",
      "aliases": ["影片类型", "内容类型", "影片", "movieType"],
      "setSignals": ["\\d+种", "[一二三四五六七八九十两几多各]种", "几种", "多种", "各类"],
      "domain": "probe",
      "valueDomain": "metabase_lexicon",
      "defaultWhenAbsent": true
    }
  ],
  "metricDefs": [
    {
      "id": "completion_rate",
      "aliases": ["完播率", "完播"],
      "options": [
        {
          "id": "avg_max_progress",
          "label": "最大观看进度平均值",
          "groundSignals": ["最大进度", "最大观看进度", "maxWatchProgress"],
          "compile": {
            "kind": "avg_of_max",
            "valueField": "maxWatchProgress",
            "entityKeys": ["guid", "eid"]
          }
        },
        {
          "id": "pct_ge_threshold",
          "label": "进度≥阈值占比",
          "groundSignals": ["阈值", "大于等于", "≥"]
        }
      ]
    },
    {
      "id": "watch_duration",
      "aliases": ["观看时长", "人均时长", "人均观看时长", "watchSecond"],
      "options": [
        {
          "id": "avg_watch_second_per_user",
          "label": "人均观看时长（秒）",
          "groundSignals": ["人均", "人均观看", "人均时长"],
          "compile": {
            "kind": "avg_per_user",
            "valueField": "watchSecond",
            "distinctField": "guid"
          }
        },
        {
          "id": "sum_watch_second",
          "label": "观看时长合计（秒）",
          "groundSignals": ["时长合计", "总时长", "总观看", "观看时长合计"],
          "compile": {
            "kind": "sum",
            "valueField": "watchSecond"
          }
        }
      ]
    },
    {
      "id": "pay_rate",
      "aliases": ["付费率", "支付率", "付费转化"],
      "tables": ["elt_film_user", "elt_film_order"],
      "requiredSlots": ["channel", "appVersion"],
      "options": [
        {
          "id": "pay_rate_lang_wide",
          "label": "付费率（按语言）",
          "groundSignals": ["付费率", "支付率", "付费转化"],
          "compile": {
            "kind": "ratio",
            "ratio": {
              "relationshipId": "user_order",
              "denominatorTable": "elt_film_user",
              "numeratorTable": "elt_film_order",
              "numeratorDistinctField": "uid",
              "numeratorTimeField": "createdTime",
              "numeratorFilters": { "orderStatus": ["6"] },
              "pivotField": "contentLang",
              "filterFields": {
                "channel": { "elt_film_user": "channel", "elt_film_order": "channelName" },
                "appVersion": { "elt_film_user": "appVersion", "elt_film_order": "appVersion" }
              }
            }
          }
        }
      ]
    },
    {
      "id": "retention",
      "aliases": ["留存", "次日留存", "D1留存"],
      "tables": ["elt_new_guid", "elt_active_guid", "gather"],
      "requiredSlots": ["channel", "appVersion"],
      "options": [
        {
          "id": "retention_d1_lang",
          "label": "次日留存（按语言）",
          "groundSignals": ["留存1", "按语言", "语言拆列", "小语种列"],
          "compile": {
            "kind": "retention_dn",
            "retention": {
              "n": 1,
              "layout": "wide",
              "cohortTable": "elt_new_guid",
              "cohortDateField": "createDate",
              "cohortChannelField": "channel",
              "activeTable": "elt_active_guid",
              "activeDateField": "activeDate",
              "activeChannelField": "channel",
              "keyField": "guid",
              "lang": {
                "table": "gather",
                "schema": "gather",
                "eventName": "content_language_save_success",
                "timeField": "createTime",
                "langField": "contentLang",
                "versionField": "appVerName",
                "channelField": "channel"
              }
            }
          }
        },
        {
          "id": "retention_d1_total",
          "label": "次日留存（合计）",
          "defaultWhenAbsent": true,
          "groundSignals": ["留存2", "新用户次日留存"],
          "compile": {
            "kind": "retention_dn",
            "retention": {
              "n": 1,
              "layout": "total",
              "cohortTable": "elt_new_guid",
              "cohortDateField": "createDate",
              "cohortChannelField": "channel",
              "activeTable": "elt_active_guid",
              "activeDateField": "activeDate",
              "activeChannelField": "channel",
              "keyField": "guid",
              "lang": {
                "table": "gather",
                "schema": "gather",
                "eventName": "content_language_save_success",
                "timeField": "createTime",
                "langField": "contentLang",
                "versionField": "appVerName",
                "channelField": "channel"
              }
            }
          }
        }
      ]
    },
    {
      "id": "dau",
      "aliases": ["日活", "活跃用户"],
      "tables": ["elt_active_guid"],
      "requiredSlots": ["channel"],
      "options": [
        {
          "id": "dau",
          "label": "日活（去重设备）",
          "groundSignals": ["日活", "活跃用户"],
          "compile": {
            "kind": "uniq",
            "distinctField": "guid"
          }
        }
      ]
    }
  ],
  "capabilities": {
    "ops": [
      "base_aggregate",
      "pivot_wide",
      "pivot_long",
      "side_by_side",
      "yoy",
      "mom",
      "growth_rate",
      "merge_ratio"
    ],
    "metrics": [
      "uniq_users",
      "sum_watch_second",
      "avg_watch_second_per_user",
      "avg_max_progress",
      "pay_rate_lang_wide",
      "retention_d1_lang",
      "retention_d1_total",
      "dau"
    ],
    "downgradePolicy": "strict",
    "unsupportedOpsHint": {
      "yoy": {
        "hint": "同比（本期 vs 去年同期）",
        "groundSignals": ["同比", "同比增长", "yoy", "YoY", "year-over-year", "year over year"]
      },
      "growth_rate": {
        "hint": "增长率（相对基期）",
        "groundSignals": ["增长率", "增速", "growth rate", "growth_rate"]
      },
      "merge_ratio": {
        "hint": "多步比值/增长率合并",
        "groundSignals": []
      },
      "mom": {
        "hint": "环比（本期 vs 等长上一窗）",
        "groundSignals": ["环比", "环比增长", "mom", "MoM", "month-over-month"]
      },
      "top_n": {
        "hint": "TopN 排名尚未建模",
        "groundSignals": ["TopN", "Top N", "top\\s*\\d+", "前\\d+名", "前\\d+", "排行", "排名"]
      },
      "percentile": {
        "hint": "分位数尚未建模",
        "groundSignals": ["分位", "percentile", "P50", "P90", "P95", "P99"]
      },
      "merge_diff": {
        "hint": "多步差值合并尚未建模",
        "groundSignals": []
      }
    }
  },
  "delivery": {
    "missingChannel": "zero_fill"
  }
}
