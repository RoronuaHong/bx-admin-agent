PORT=8787
WEB_ORIGIN=http://localhost:5173
# 匿名会话有效期（毫秒）
SESSION_TTL_MS=28800000
# 单次模型请求超时（毫秒）
MODEL_TIMEOUT_MS=120000
# 单次回复输出上限（token）。上下文预算会为它预留空间，改这里要一致生效。
# MODEL_MAX_OUTPUT_TOKENS=8192
# 可选：注入固定 system 前缀（默认不注入任何提示词）
# AGENT_GUIDE=

# ---- 上下文预算（token；预算由「模型窗口」推导，不再用固定字符数）----
# 跨轮历史最多保留轮数
# HISTORY_MAX_TURNS=8
# 安全系数：可用预算 = (窗口 − 输出预留 − 工具 schema − 本轮工具结果预算) × 该系数
# CONTEXT_SAFETY_RATIO=0.8
# ---- 聊天附件（用户贴的 PDF/Word/Excel/md/txt/csv 解析后注入系统提示）----
# 单附件注入上限（token；CJK ≈ 1 token/字，超出的部分截断并注明原文长度）
# ATTACH_MAX_TOKENS=8000
# 本轮所有附件合计上限（token）。附件进的是**系统提示**，不参与历史预算，故单独设闸门
# ATTACH_TOTAL_MAX_TOKENS=20000
# ---- 本轮工具结果治理（对齐 tool-result clearing 的 trigger/keep 语义）----
# 本轮工具结果总预算（token），超出后从最旧的开始清理
# MCP_TOOL_RESULT_BUDGET=12000
# 最近 N 组工具结果永不清理
# MCP_TOOL_RESULT_KEEP=3
# 白名单：这些工具的结果永不清理（逗号分隔工具名）
# MCP_TOOL_RESULT_PROTECT=
# 句柄中保留的参数原文长度
# MCP_HANDLE_ARGS_CHARS=200

# ---- 接地护栏（防「零数据凭记忆作答」；角色级开关见 src/roles.ts 的 enforceGrounding）----
# off = 关闭（缺省 on）：声明 enforceGrounding 的角色在「本轮没拿到任何外部数据」时不得以正文结论收束
# GROUNDING_GUARD=on
# 纠正次数：作废该段文本 + 回灌提示让模型补取数据；用尽后改用确定性拒答（0 = 首次即拒答）
# GROUNDING_MAX_RETRIES=1
# 事后核验（Chain-of-Verification 最小版）：收束前把「回答 + 本轮证据」交给同一模型做一次断言级核对，
# 发现无支持断言就作废并回灌纠正。代价 = 每次收束多一次模型调用（不流式、不展示给用户）
# GROUNDING_VERIFY=on
# 核验次数上限（用尽后不再核验，直接采信；保证最坏情况只多一轮）
# GROUNDING_VERIFY_MAX=1
# 多票裁决次数（>1 = 跑 N 次独立核验、多数票认定无支持才作废，降低核验器自身误判；代价线性叠加）
# GROUNDING_VERIFY_VOTES=1
# 送入核验器的证据字符上限（证据过长时截断，核验不能变成新的上下文负担）
# GROUNDING_EVIDENCE_CHARS=12000

# ---- MCP 工具注入与连接运维 ----
# 注入模型的工具数上限：超出按确定性顺序截断，并把被裁掉的服务器写进系统提示（不静默丢弃）
# MCP_MAX_TOOLS=80
# 工具按需加载（Tool Search）：auto = MCP 工具 schema 占上下文窗口超过 TOOL_SEARCH_RATIO 才按需；
# on = 强制按需（只注入工具名 + search_tools，模型检索后加载 schema）；off = 永远全量注入
# TOOL_SEARCH_MODE=auto
# TOOL_SEARCH_RATIO=0.1
# 单次检索最多返回并加载多少个工具（硬上限 20）
# TOOL_SEARCH_RESULTS=8
# 系统提示里工具索引（仅名称）最多列多少个
# TOOL_CATALOG_MAX_NAMES=200
# 连接失败后的重试冷却（毫秒）：避免一个挂掉的 server 让每一轮对话都等一次连接超时
# MCP_RECONNECT_COOLDOWN_MS=30000
# 空闲连接回收：超过阈值没用过就断开（stdio 子进程不常驻），0 = 关闭；扫描间隔
# MCP_IDLE_TIMEOUT_MS=1800000
# MCP_IDLE_SWEEP_MS=300000
# 确认门保守口径：on = 未声明 destructiveHint 的工具也需用户确认（缺省 off）
# MCP_CONFIRM_STRICT=off

# ---- 内置 MCP 服务器（JSON 数组；随环境提供、不落盘）----
# 用于「部署期就确定」的服务器：不必写进代码，也不需要用户在前端手工添加；
# 前端 MCP 面板只负责「选择启用哪些」。同 id 时以 .data/mcp-servers.json 为准，便于本地覆盖。
# 凭据不要写在这里：stdio 子进程会继承父进程环境，凭据放本 .env 即可（见下方 BI_* / YAPI_* 示例）。
# requireConfirm=true → 该 server 每次调用都弹确认；timeoutMs → 单次工具调用超时（毫秒，默认 60000）。
# 通用示例：MCP_BUILTIN_SERVERS=[{"id":"my-server","label":"My Server","transport":"stdio","command":"node","args":["scripts/my-mcp.mjs"]}]
# 仓库自带两个适配器（取消注释即可接入；凭据见下方 BI_* / YAPI_*）：
#   BI 指标（需 BI_BASE_URL + BI_API_KEY）：
#     MCP_BUILTIN_SERVERS=[{"id":"bi","label":"BI 指标","transport":"stdio","command":"node","args":["scripts/metabase-mcp.mjs"],"toolRisks":{"list_databases":"read","get_database_schema":"read","get_field_values":"read","search":"read","list_cards":"read","get_card":"read","list_dashboards":"read","get_dashboard":"read","run_native_query":"destructive"}}]
#     注：run_native_query 执行任意 SQL（效果取决于传入文本）→ destructive，每次调用弹确认卡；
#     其余工具声明 readOnlyHint（只读注解），未单独配 toolRisks 时也不会弹卡。
#     适配器新增/删除工具后：这里要同步补级别（缺级别走「未知」兜底＝弹确认卡），并重连该服务器才生效。
#   YApi 接口文档（需 YAPI_*；写操作已硬禁，仍建议 requireConfirm）：
#     MCP_BUILTIN_SERVERS=[{"id":"yapi","label":"YApi 接口","transport":"stdio","command":"node","args":["scripts/yapi-mcp.mjs"],"requireConfirm":true}]
#   同时接入多个：把上面两段的 {...} 作为元素放进同一个 JSON 数组即可。
#   HTTP(Streamable HTTP) 示例——无需本地进程；用 tools 白名单收窄暴露面、toolRisks 把只读工具免确认：
#     观影助手数据源（TMDb，公共托管、零 key；全部只读 → toolRisks 走 * 免确认）：
#     MCP_BUILTIN_SERVERS=[{"id":"movie","label":"电影(TMDb)","transport":"http","url":"https://orca-mcp.mmdju.workers.dev/mcp","tools":["movies_search","movies_details","movies_discover","movies_trending","movies_similar","movies_reviews","movies_ratings","movies_compare_lists","movies_collection","movies_person","movies_keywords","movies_companies","tv_season","tv_episode","tv_episodes","movies_videos","movies_artwork","movies_where_to_watch","release_calendar","find_by_external_id","person_watch_path"],"toolRisks":{"*":"read"}}]
#     想直连 TMDb（npx -y tmdb-mcp，31 工具，可选 OMDb 补 IMDb/烂番茄评分）：加 TMDB_API_TOKEN 后把 movie 项换成
#     {"id":"movie","label":"电影(TMDb)","transport":"stdio","command":"npx","args":["-y","tmdb-mcp"],"tools":["search_movies","get_movie","get_reviews","get_similar","get_trending","discover_movies"],"toolRisks":{"*":"read"}}
#   图表可视化（路线 3：本地渲染，当前唯一路径）——出图走内置工具 render_chart + 前端 ChartCard，
#   浏览器本地绘制，零外链、数据不出本机。内置工具**始终注入**，因此无需为此启用任何 MCP。
#   路线 1（AntV 官方出图服务：数据出内网 + 图片落公有 CDN）**已下线**：不要再往这里加 chart 服务器，
#   历史配置片段见 docs/chart-visualization-plan.md §5。
# MCP_BUILTIN_SERVERS=

# ---- 模型注册表 ----
# MODEL_PROVIDERS=逗号分隔的模型 id，第一个为默认；每个模型以 MODEL_<ID>_ 为前缀声明：
#   PROVIDER=anthropic|openai|ollama
#   NAME=上游 model 字段
#   BASE_URL=上游端点
#   API_KEY=上游密钥（NVIDIA 端点可用 NVIDIA_API_KEYS 逗号分隔多 key 轮询）
#   VISION=direct（图片直传）| ocr（未实现，等同 none）| none
#   CONTEXT_WINDOW=上下文窗口 token（缺省取 MODEL_CONTEXT_WINDOW，再缺省 128000）
#   TIMEOUT_MS / LABEL 可选
# 第一个 = 默认模型。hy-vision-2.0-instruct（腾讯 TokenHub 在线推理服务，OpenAI 兼容端点）。
MODEL_PROVIDERS=hyvision,kimi
# 视觉模型（vision=direct，用于图片输入）
MODEL_HYVISION_PROVIDER=openai
MODEL_HYVISION_NAME=hy-vision-2.0-instruct
MODEL_HYVISION_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_HYVISION_API_KEY=your-key
MODEL_HYVISION_VISION=direct
MODEL_HYVISION_TIMEOUT_MS=180000
MODEL_HYVISION_LABEL=Hy3-视觉
# Kimi-K2.5（腾讯 TokenHub 在线推理服务，OpenAI 兼容端点；思维链模型）。
MODEL_KIMI_PROVIDER=openai
MODEL_KIMI_NAME=kimi-k2.5
MODEL_KIMI_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_KIMI_API_KEY=your-key
MODEL_KIMI_VISION=none
MODEL_KIMI_TIMEOUT_MS=300000
MODEL_KIMI_LABEL=Kimi-K2.5

# ---- 聊天记录持久化（MongoDB；连不上自动降级进程内存）----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=bx_agent

# ---- BI / 后台管理系统 API（MCP 选项所需，待填写）----
# BI 平台 API Key（Metabase：请求头 X-API-Key 携带）
BI_API_KEY=
# BI 只读账号的 API Key（推荐，见 docs/text2sql-text2api-plan.md 的 P1-1）：
#   配了就优先用它，没配则回落 BI_API_KEY（保留回滚路径）。
#   前置校验（缺一不可，否则会静默劣化）：① 该账号需有「原生查询编辑」权限，否则 run_native_query 不是被拦截而是整体不可用；
#   ② 可见范围要覆盖所用 collection，否则 list_cards / search / get_dashboard 静默少结果（比报错更难发现）。
BI_READONLY_API_KEY=
# BI 单次请求超时（毫秒，默认 30000；慢查询调大，并确认服务器配置的 timeoutMs 不小于它）
BI_TIMEOUT_MS=
# BI 平台基地址（Metabase 实例，如 https://bi.example.com）
BI_BASE_URL=
# 后台管理系统 API Key
ADMIN_API_KEY=

# ---- YApi 接口文档（MCP 适配器 scripts/yapi-mcp.mjs，内置服务器 id=yapi，待填写）----
# 鉴权用「账号密码换登录 cookie」，不需要项目 token
# YApi 站点地址
YAPI_BASE_URL=
# YApi 登录账号（邮箱）
YAPI_LOGIN_EMAIL=
# YApi 登录密码
YAPI_LOGIN_PASSWORD=
# 可选：直接填现成 cookie（_yapi_token=xx; _yapi_uid=xx），填了就跳过登录
# YAPI_COOKIE=
# 可选：限定项目范围（逗号分隔的项目 id），不填 = 账号可见的全部项目
# YAPI_PROJECT_IDS=
# 接口元数据缓存时长（分钟，默认 10）
YAPI_CACHE_TTL=10

# ---- YApi 真实调用（适配器的 call_api 工具：只读 GET，写操作硬禁止）----
# 调用地址：`项目id=基地址` 逗号分隔；没配的项目不允许调用。
# 例：23=http://inter-apiadmin.xxbbc.com,69=http://dl-admin.example.com
YAPI_CALL_BASES=
# 全局请求头（`名: 值` 逗号分隔），例：clientType: 5
# YAPI_CALL_HEADERS=
# 项目级请求头（覆盖全局），例：YAPI_CALL_HEADERS_23=clientType: 5
# YAPI_CALL_HEADERS_23=
# 项目级固定 query 参数（`键=值` 逗号分隔），例：YAPI_CALL_QUERY_182=clientType=5
# YAPI_CALL_QUERY_182=
# Bearer token（可选；填了就用它，不再自动登录）
# YAPI_CALL_TOKEN=
# 业务后台账号（自动登录换 token 用；不是 YApi 的账号，两者是两套系统）
YAPI_CALL_LOGIN_NAME=
YAPI_CALL_LOGIN_PASSWORD=
# 各项目的登录接口路径（POST，只由适配器内部调用换 token，模型无法触发）
# 例：YAPI_CALL_LOGIN_PATH_23=/v0.1/useraccount/loginForPassword
# YAPI_CALL_LOGIN_PATH_23=
# 登录网关与调用域名不同时单独指定（同一账号体系下的不同服务域名）
# YAPI_CALL_LOGIN_BASE_23=
# 登录请求体里的账号字段名（默认 loginName）
# YAPI_CALL_LOGIN_FIELD_23=
# 调用超时（毫秒，默认 15000）
# YAPI_CALL_TIMEOUT_MS=15000

