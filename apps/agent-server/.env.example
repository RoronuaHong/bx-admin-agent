# ---- 钉钉文档检索（方案 A）----
# 用「企业内部应用」身份查询公司内部钉钉文档（alidocs.dingtalk.com）。
# 凭证需公司钉钉管理员创建应用并授权文档读权限后提供（非个人 Cookie）。
# 未配置时 search_dingtalk_doc 工具返回配置指引，不中断对话。
# DINGTALK_CLIENT_ID=你的应用ClientID
# DINGTALK_CLIENT_SECRET=你的应用ClientSecret
# DINGTALK_DOC_BASE_URL=https://api.dingtalk.com/v1.0

# ---- HTTP 限流（进程内滑动窗口；≤0 关闭该桶）----
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_LOGIN_PER_MIN=30
# RATE_LIMIT_WINDOW_MS=60000

# ---- Trace 门户权限（未配置时=所有已登录用户可看）----
# ownerKey 格式：countryId:loginName
# TRACE_ALLOWED_OWNERS=india:alice,brazil:bob
# TRACE_DENIED_OWNERS=india:temp-user
# TRACE_ALLOWED_COUNTRIES=india,brazil

# ---- Prompt 结构护栏（零自然语言词典；不拒业务文）----
# CHAT_MAX_INPUT_LEN=500
# PROMPT_GUARD_AUDIT=true

# ---- 运维告警推送（钉钉自定义机器人 Webhook；未配则静默）----
# 真实 token 只写 .env，勿提交；安全设置关键词建议 bx-agent（与告警标题一致）
# ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=...
# ALERT_BUDGET_NOTIFY=true
# ALERT_DEGRADE_NOTIFY=true
# ALERT_ANALYTICS_NOTIFY=true
# ALERT_DEDUP_MS=1800000
# 巡检消息「内嵌图表」开关（默认 0=关）。
# 事实：钉钉自定义机器人 webhook 不支持 msgtype=image；内嵌图唯一通道是 markdown ![](url)，
# 且图片 URL 必须公网可达（钉钉服务端要能取到）→ 内网 base url 下开了也不会显示。
# 开启后消息会附一张报告页截图；图片由本服务 GET /analytics/report/:token/image.png 渲染并缓存。
# 注意：base url 为私网/回环地址时会**自动跳过内嵌图**（已实测钉钉取不到，会留裂图占位）。
# ALERT_REPORT_IMAGE=0
# 确实是私网自建钉钉、且其服务端能取到图时，可跳过公网可达性预检强制内嵌：
# ALERT_REPORT_IMAGE_FORCE=0
# 渲染用浏览器可执行文件（默认自动探测 Chrome/Edge）；无浏览器时自动降级为「文本柱状图 + 报告链接」。
# ALERT_REPORT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# 消息形态：markdown（默认，正文里放文字链接）/ action_card（卡片正文 + 底部实体按钮，
# 按钮即「查看完整报告 / 去问数追问」；正文压缩到 top8 渠道以贴合官方 ≤1000 字符建议）。
# ALERT_MSGTYPE=markdown
# 严重度/异常是否用 <font color="#RRGGBB"> 上色（红=严重 橙=预警 绿=正常 / 涨绿跌红）。
# 真机已验证钉钉自定义机器人 markdown 支持该标签（6 位 hex、须闭合），默认开启。
# 若客户端确实不渲染原始标签，可显式关闭：ALERT_FONT_COLOR=0
ALERT_FONT_COLOR=1
# 钉钉自定义机器人「关键词安全设置」：消息正文/标题须含此词，否则被静默拒收（errcode 310000）。
# 需在机器人安全设置里查看实际关键词，与群一致。
# ALERT_KEYWORD=Agent

# ---- Metabase（数据分析 Agent / 冒烟脚本 scripts/metabase-smoke.mjs）----
# 账号密码即可（POST /api/session）；有 API Key 也可后续改用 METABASE_API_KEY。
# 连通验证：bi.vmovs.com 主库 database id 多为 2（ClickHouse）；以实例为准。
# METABASE_URL=https://bi.vmovs.com
# METABASE_USERNAME=your@email.com
# METABASE_PASSWORD=your-password
# METABASE_DATABASE_ID=2
# METABASE_SMOKE_SQL=SELECT 1
# 全局去重口径（定稿 §7.2；评测/Agent 共用）
# DISTINCT_COUNT_FN=uniq
# ANALYTICS_BUSINESS_TIMEZONE=Asia/Shanghai
# ANALYTICS_QUERY_TIMEOUT_MS=120000   # Metabase/CH 单次问数查询超时（也可写在 pack.guards.queryTimeoutMs）
# ANALYTICS_CATALOG_REFRESH=1         # 问数前拉 Metabase metadata 对账表/字段；0 关闭
# ANALYTICS_CATALOG_TTL_MS=600000     # catalog 缓存（默认 10 分钟）

# ---- M2 评测门禁（analytics-eval-harness）----
# ANALYTICS_EVAL_MODE=refuse|full   # 默认：有 Metabase 凭据则 full，否则 refuse
# GATE_EX_MIN=0.85
# GATE_REFUSE_RECALL_MIN=0.95
# GATE_REFUSE_PRECISION_MIN=0.8
# GATE_CWR_MAX=0.1
# GATE_EX_REGRESSION_MAX_PP=3
# ANALYTICS_EVAL_WRITE_BASELINE=1   # full 过门后写 config/analytics/eval/baseline.json（仅 gold EX）
# seed reviewStatus=gold|provisional — GATE EX 只计 gold；可答题须人工把 provisional 改成 gold
# ANALYTICS_EVAL_MODEL=dsflash   # harness --model 优先；pipeline 默认也可设 ANALYTICS_DEFAULT_MODEL
# ANALYTICS_DEFAULT_MODEL=dsflash
# ANALYTICS_LLM_SQL=on            # Path C 模型写 SQL；off 则未建模问数 refuse
# ANALYTICS_LLM_VERIFY=1           # M2 执行后校对；0 关闭
# ANALYTICS_LLM_VERIFY_STRICT=1    # unclear 二次仍不清时拒绝（默认：结构护栏已过后 soft-pass）
# ANALYTICS_LLM_INSIGHT=1          # 执行后自然语言解读；0 关闭。数字必须来自样例行，禁止改写/预测未出现的数
# ANALYTICS_BINDING_QID_indiaA_day_users=123   # 可选：覆盖 pack 中对应 binding 的 Metabase card id
# ANALYTICS_LEDGER_RETENTION_DAYS=30          # ask 账本 JSONL 保留天数

# ---- M3 巡检（internal scan API；真实 token 只写 .env，勿提交）----
# SCAN_INTERNAL_TOKEN=replace-with-long-random-token
# ANALYTICS_SCAN_WORKER=1
# ANALYTICS_SCAN_CRON=1                 # 进程内每日入队（须同时 worker=1）；未配钉钉则静默
# ANALYTICS_SCAN_CRON_HHMM=10:00        # 业务时区 ANALYTICS_BUSINESS_TIMEZONE 下的触发时刻
# 巡检消息里「报告页 / 报告图」的基地址（含协议+域名，不含尾斜杠）。
# 未配 → 链接退化为站内相对路径（钉钉里不可点）；内嵌图还要求它公网可达（见 ALERT_REPORT_IMAGE）。
# ANALYTICS_WEB_BASE_URL=http://192.168.50.129:5173
# 巡检报告（JSON 快照 + 配图 PNG）保留天数；超期在下次落盘时自动清理，0/负数=永久保留。
# ANALYTICS_REPORT_RETENTION_DAYS=30
# ruleset.retentionDays（默认 30）入队时清理内存中过期终态 job
# M3_SMOKE_NOTIFY=1   # analytics-m3-smoke 额外跑 dryRun=false 实推钉钉