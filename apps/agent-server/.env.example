MOCK_UPSTREAM=true
PORT=8787
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_MS=28800000
CONFIRM_TTL_MS=300000
MODEL_TIMEOUT_MS=120000
# ---- 多模型注册表（企业通用 Agent 核心）----
# MODEL_PROVIDERS=hy3,dsflash,glm5,glm52,glm5turbo,deepseek  ← 逗号分隔的模型 ID，可注册任意多个
# 每个模型以 MODEL_<ID>_ 为前缀声明：
#   PROVIDER: anthropic | openai | ollama
#   NAME: 模型名（发给上游的 model 字段）
#   BASE_URL: 上游端点
#   API_KEY: 可选；anthropic 走 x-api-key（TokenHub 兼容），openai 走 Bearer
#   VISION: direct（把图片块直传给模型）| ocr（本地转文字后注入，供无视觉模型用）| none（拒绝图片）
#   TIMEOUT_MS: 单次请求超时（默认取 MODEL_TIMEOUT_MS）
#   LABEL: 前端下拉展示名（缺省用 NAME）
MODEL_PROVIDERS=hy3,glm51,dsflash,glm5,glm52,glm5turbo,deepseek
MODEL_HY3_PROVIDER=anthropic
MODEL_HY3_NAME=hy3
MODEL_HY3_BASE_URL=https://tokenhub.tencentmaas.com
MODEL_HY3_API_KEY=__ANTHROPIC_AUTH_TOKEN__
MODEL_HY3_VISION=none
MODEL_HY3_TIMEOUT_MS=120000
MODEL_HY3_LABEL=hy3
# TokenHub OpenAI 兼容示例（DeepSeek-Flash）
# https://console.cloud.tencent.com/tokenhub/inference/detail/basic?id=deepseek/deepseek-flash
MODEL_DSFLASH_PROVIDER=openai
MODEL_DSFLASH_NAME=deepseek/deepseek-flash
MODEL_DSFLASH_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_DSFLASH_API_KEY=__TOKENHUB_API_KEY__
MODEL_DSFLASH_VISION=none
MODEL_DSFLASH_TIMEOUT_MS=120000
MODEL_DSFLASH_LABEL=DeepSeek-Flash
# TokenHub OpenAI 兼容示例（GLM-5.1）
# https://console.cloud.tencent.com/tokenhub/inference/detail/basic?id=glm-5.1
MODEL_GLM51_PROVIDER=openai
MODEL_GLM51_NAME=glm-5.1
MODEL_GLM51_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_GLM51_API_KEY=__TOKENHUB_API_KEY__
MODEL_GLM51_VISION=none
MODEL_GLM51_TIMEOUT_MS=180000
MODEL_GLM51_LABEL=GLM-5.1
# TokenHub OpenAI 兼容示例（GLM-5）
# https://console.cloud.tencent.com/tokenhub/inference/detail/basic?id=glm-5
MODEL_GLM5_PROVIDER=openai
MODEL_GLM5_NAME=glm-5
MODEL_GLM5_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_GLM5_API_KEY=__TOKENHUB_API_KEY__
MODEL_GLM5_VISION=none
MODEL_GLM5_TIMEOUT_MS=180000
MODEL_GLM5_LABEL=GLM-5
# TokenHub OpenAI 兼容示例（GLM-5.2）
MODEL_GLM52_PROVIDER=openai
MODEL_GLM52_NAME=glm-5.2
MODEL_GLM52_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_GLM52_API_KEY=__TOKENHUB_API_KEY__
MODEL_GLM52_VISION=none
MODEL_GLM52_TIMEOUT_MS=120000
MODEL_GLM52_LABEL=GLM-5.2
# TokenHub OpenAI 兼容示例（GLM-5-Turbo）
# https://console.cloud.tencent.com/tokenhub/inference/detail/basic?id=glm-5-turbo
MODEL_GLM5TURBO_PROVIDER=openai
MODEL_GLM5TURBO_NAME=glm-5-turbo
MODEL_GLM5TURBO_BASE_URL=https://tokenhub.tencentmaas.com/v1
MODEL_GLM5TURBO_API_KEY=__TOKENHUB_API_KEY__
MODEL_GLM5TURBO_VISION=none
MODEL_GLM5TURBO_TIMEOUT_MS=120000
MODEL_GLM5TURBO_LABEL=GLM-5-Turbo
# openai 兼容示例（DeepSeek / 其他网关）
MODEL_DEEPSEEK_PROVIDER=openai
MODEL_DEEPSEEK_NAME=deepseek-chat
MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__
MODEL_DEEPSEEK_VISION=none
MODEL_DEEPSEEK_TIMEOUT_MS=120000
MODEL_DEEPSEEK_LABEL=DeepSeek

# ---- 并行 tool_calls（OpenAI 兼容）----
# 默认关闭并行（正常契约：同轮至多 1 个 tool_call）。流式出现第 2 槽立即取消剩余生成。
# 设 PARALLEL_TOOL_CALLS=1 才允许并行；此时 MAX_PARALLEL_TOOL_SLOTS 为上限（默认 6）。
# PARALLEL_TOOL_CALLS=0
# MAX_PARALLEL_TOOL_SLOTS=6
# 本地 Ollama 示例（可选）
# MODEL_OLLAMA_PROVIDER=ollama
# MODEL_OLLAMA_NAME=qwen2.5:7b
# MODEL_OLLAMA_BASE_URL=http://localhost:11434
# MODEL_OLLAMA_VISION=ocr
# MODEL_OLLAMA_TIMEOUT_MS=300000
# MODEL_OLLAMA_LABEL=Ollama-本地
# ---- 内容源（@file: 语法读取的本地文档目录）----
AGENT_DOCS_DIR=./docs

# ---- grep_codebase 工具：全局代码搜索根目录 ----
# Agent 用 ripgrep 在此目录下全局搜索关键词/模块名/函数名，类似 Cursor IDE 的符号搜索。
# 配置为业务前端项目根目录，Agent 就能定位任意模块、接口函数、中文名的代码位置。
CODEBASE_ROOT=D:\Code\bx-film-admin-in2
# ---- 方案 A（2026-08-22）：gitlab 代码库拉取（git 协议 + 本机 credential manager 凭据）----
# gitlab REST API（http 301→https，https 443 常不通）不可用，改用 git 协议拉取到服务端缓存目录。
# GITLAB_GIT_BASE 可含用户名（如 https://hong@git.work.xxbbc.com/），凭据走 Windows credential manager。
GITLAB_GIT_BASE=https://hong@git.work.xxbbc.com/
# 未显式配 codebaseRoot 的项目，代码落到 <GITLAB_REPO_CACHE_DIR>/<projectKey>
GITLAB_REPO_CACHE_DIR=D:\Code\bx-agent-repos
# normalize_output 工具使用的字段映射配置文件路径（superpower 层，修改此文件即可更新映射）
# normalize_output / 澄清策略等配置（均在 bx-admin-agent 仓库 docs/agent）
FIELD_MAPPING_PATH=D:\Code\bx-admin-agent\docs\agent\field-mapping.json
CLARIFICATION_POLICY_PATH=D:\Code\bx-admin-agent\docs\agent\clarification-policy.json
# 也可以配置多个目录（逗号分隔，工具当前取第一个，后续可扩展多仓库搜索）
# CODEBASE_ROOT=D:\Code\bx-film-admin-in2,D:\Code\bx-other-project
LINK_MAX_BYTES=2097152
LINK_TIMEOUT_MS=15000
CONTEXT_MAX_CHARS=20000

# ---- 澄清指标 MongoDB 持久化（会自动建库建集合）----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=bx_agent_metrics
MONGO_METRICS_COLLECTION=clarification_metrics

COUNTRY_INDIA_LABEL=India
