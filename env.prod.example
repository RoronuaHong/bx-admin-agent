# ============================================================
# 生产环境变量模板（cp 为 .env.prod 后填写；.env.prod 已被 .gitignore 忽略，切勿提交）
#
# 启动：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================================

# ---- 域名（Caddy 据此自动申请 Let's Encrypt 证书；内网自测改 localhost）----
DOMAIN=your.domain.com

# ---- 安全（HOST=0.0.0.0 必填！请改为一段足够长的随机串，例如 `openssl rand -hex 32`）----
AGENT_ADMIN_TOKEN=__CHANGE_ME_TO_A_LONG_RANDOM_TOKEN__

# ---- 前端访问来源（填 https 域名，供后端 origin 校验；同源部署下主要用于审计/校验）----
WEB_ORIGIN=https://your.domain.com

# ---- MongoDB：生产用外部托管 URI（含账号密码与 authSource）；不要放进应用栈 ----
MONGO_URI=mongodb://USER:PASS@host:27017/?authSource=admin
MONGO_DB_NAME=bx_agent

# ---- 运行时数据目录（容器内挂卷到 /data；含 trace / 审计 / 上传 / 工作区）----
AGENT_DATA_DIR=/data

# ---- 模型（至少配一个；示例 OpenAI，anthropic / ollama 同理）----
# MODEL_PROVIDERS=default
# MODEL_DEFAULT_PROVIDER=openai
# MODEL_DEFAULT_NAME=gpt-4o
# MODEL_DEFAULT_BASE_URL=https://api.openai.com
# MODEL_DEFAULT_API_KEY=sk-...
# NVIDIA_API_KEYS=

# ---- MCP（可选；stdio 类型脚本需已随镜像打包在 scripts/ 下存在）----
# MCP_BUILTIN_SERVERS=[]
# MCP_ALLOWED_COMMANDS=node,npx
# MCP_REQUIRE_PROVENANCE=on
